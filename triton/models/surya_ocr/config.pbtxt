name: "surya_ocr"
backend: "python"

# max_batch_size: 1 keeps a leading batch dim so the same client wire
# format works against PyTriton (which requires max_batch_size>=1) and
# this C++ Python-backend config. Cross-request batching is still
# disabled in practice — the model only ever sees batch=1; concurrency
# comes from instance_group below (one CUDA stream per instance) and
# within a request surya batches via recognition_batch_size.
max_batch_size: 1

input [
  {
    name: "IMAGE_PNG"
    data_type: TYPE_STRING
    dims: [ -1 ]
  },
  {
    name: "MATH_MODE"
    data_type: TYPE_BOOL
    dims: [ 1 ]
    optional: true
  },
  {
    name: "RECOGNITION_BATCH_SIZE"
    data_type: TYPE_INT32
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "TEXT"
    data_type: TYPE_STRING
    dims: [ -1 ]
  }
]

# Two GPU instances on the same device → real concurrent execution via
# separate CUDA streams. Bump to 3-4 if VRAM allows; each instance
# holds its own surya predictor copy. Set count=1 + KIND_CPU on hosts
# without a GPU (or override via FORCE_CPU=1 below).
instance_group [
  {
    count: 2
    kind: KIND_GPU
  }
]

parameters [
  { key: "FORCE_CPU"     value: { string_value: "0" } },
  { key: "EAGER_LOAD"    value: { string_value: "1" } }
]
